# config, wave 2: IntentLock API URL (Render URL after deploy).
INTENTLOCK_API_URL=http://localhost:8000
# config, wave 2: Agent id returned by POST /agents (seed uses agt_demo_shopper).
AGENT_ID=agt_demo_shopper
# generated, wave 2: Run `creds.py genkeys`.
AGENT_PRIVATE_KEY=__FILL_ME__
# generated, wave 2: Run `creds.py genkeys`; registered via POST /agents.
AGENT_PUBLIC_KEY=__FILL_ME__
# secret, wave 1: Same Channel3 key as the API.
CHANNEL3_API_KEY=__FILL_ME__
# config, wave 2: Only for local agent runs; on Astropods the agent uses the AI Gateway. Same as API.
LLM_FAST_BASE_URL=https://api.groq.com/openai/v1
# secret, wave 2: Same free key as the API.
LLM_FAST_API_KEY=__FILL_ME__
# config, wave 2: Same Groq model (tool calling).
LLM_FAST_MODEL=openai/gpt-oss-120b
