{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IntentLock shopping agent (Mastra on Astropods): reads a signed intent, builds a cart, checks out with RFC 9421 signed requests.",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "astro:dev": "bun --watch agent/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "register": "tsx scripts/register.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "main": "./agent/index.ts",
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@astropods/adapter-mastra": "latest",
    "@mastra/core": "^1.64.0",
    "@mastra/libsql": "^1.22.3",
    "@mastra/memory": "^1.28.2",
    "@mastra/observability": "^1.17.5",
    "@mastra/otel-exporter": "^1.3.13",
    "@opentelemetry/exporter-trace-otlp-proto": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^24",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
