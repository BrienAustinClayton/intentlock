# config, wave 1: IntentLock API URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
# public, wave 2: Same PayPal sandbox Client ID (public by design).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=__FILL_ME__
# secret, wave 3: AG Studio / AG Grid Enterprise 45-day trial licence (ag-grid.com trial form; email). Trial clock starts on request.
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=__FILL_ME__
# config, wave 3: Server-side only, Risk Analyst agent (free model; Jev budget stays in the API).
LLM_FAST_BASE_URL=https://api.groq.com/openai/v1
# secret, wave 3: Same free key. Never prefix with NEXT_PUBLIC_.
LLM_FAST_API_KEY=__FILL_ME__
# config, wave 3: Same Groq model (tool calling).
LLM_FAST_MODEL=openai/gpt-oss-120b
